# =============================================================================
# Server Environment Variables — TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Create a DB user with minimal required permissions.
# Rotate this password regularly.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# SECURITY: Must be a cryptographically random 64-character hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this secret invalidates ALL existing sessions immediately.
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret used for initial admin account creation.
# SECURITY: Change from the default before first deployment.
ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq (primary AI provider — fast, generous free tier)
GROQ_API_KEY=gsk_REPLACE_WITH_GROQ_KEY

# Gemini (fallback AI provider)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

# OpenAI (optional — unused if Groq/Gemini are configured)
# OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY

# ── Render Deployment ─────────────────────────────────────────────────────────
# Automatically set by Render — used for self-ping keep-alive
# RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
